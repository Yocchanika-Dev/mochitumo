DATABASE_PATH=./data/mobaeco.sqlite
# 明示指定時だけ読込: BACKEND_ENV_FILE=.env.local npm start
# 旧Web/仮想Bike03デモは通常無効。本番ではtrueを拒否。
ENABLE_VIRTUAL_BIKE=false
TRUST_PROXY=

# Development-only dummy NFC credentials
NFC_API_URL=http://localhost:3000
NFC_MOCK_DEVICE_ID=nfc-reader-01
NFC_MOCK_DEVICE_KEY=dev-only-nfc-key-change-me
NFC_MOCK_CARD_UID=012E5CE5D8107067
ALLOW_INSECURE_NFC_HTTP=true

# 隔離LAN用ダミー値。本番の秘密情報をこのファイルへ書かない。
LINE_SERVICE_TOKEN=dev-only-line-service-token-change-me
LINE_CHANNEL_SECRET=dev-only-line-channel-secret
LINE_BACKEND_URL=http://localhost:3000

# off / mock / usb。実機はbikeのdevice_id/relay_id登録も必要。
SERIAL_MODE=off
SERIAL_PORT=/dev/cu.usbmodem_REPLACE_ME
SERIAL_BAUD_RATE=115200
SERIAL_RELAY_ID=RELAY01

# LINE側の募集受信API。URL・トークン両方を設定すると送信worker有効。
# 実トークンはGit対象外の.envにだけ保存し、別途安全に共有する。
BACKEND_EVENTS_URL=
BACKEND_EVENTS_TOKEN=
